[Unit]
Description=ALP Metrics scheduled V3 data update
Wants=network-online.target alp-metrics-web.service
After=network-online.target alp-metrics-web.service

[Service]
Type=oneshot
User=azureuser
WorkingDirectory=/home/azureuser/web-portal
ExecStart=/home/azureuser/web-portal/.venv/bin/python /home/azureuser/web-portal/scripts/run_scheduled_update.py
Environment=PYTHONUNBUFFERED=1
UMask=0077
TimeoutStartSec=2h
TimeoutStopSec=60s
KillMode=control-group
