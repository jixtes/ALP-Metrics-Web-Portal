ALP_PIPELINE_REPO_PATH=../alp-metrics-pipeline
ALP_V2_PIPELINE_REPO_PATH=../alp-metrics-pipeline-v2
# Relative to the V2 checkout. Defaults to its .runner-venv Python when present.
ALP_V2_PYTHON=.runner-venv/bin/python
ALP_V2_TIMEOUT_SECONDS=3600
V2_SHAREPOINT_FOLDER=ALP/ALP Metrics/3. Portal Pipeline/V2

SECRET_KEY=change-this-secret-key
SECURITY_PASSWORD_SALT=change-this-password-salt
SESSION_COOKIE_SECURE=false
ALP_RESET_LINK_HOURS=168
ALP_INITIAL_ADMIN_EMAIL=admin@example.com
ALP_INITIAL_ADMIN_PASSWORD=change-this-password
ALP_INITIAL_ADMIN_NAME=Admin

MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
SHAREPOINT_SITE_URL=https://yourorg.sharepoint.com/sites/your-team-site
SHAREPOINT_LIBRARY=Documents
SHAREPOINT_FOLDER=ALP Metrics/Exports
SHAREPOINT_INPUT_FOLDER=ALP Metrics/Exports/inputs
SHAREPOINT_XLSFORM_PATH=ALP/ALP Metrics/4. Product Development/1. Sample Details and Survey Forms/V3/OFFICIAL Versions/ALP_Metrics_Survey_v3.xlsx
SURVEYCTO_TEST_SHAREPOINT_FOLDER=ALP Metrics/Exports/test_survey
SURVEYCTO_WEBHOOK_SECRET=replace-with-a-long-random-token
SURVEYCTO_WEBHOOK_DEDUP_SECONDS=300
SURVEYCTO_WEBHOOK_RESPONDENT_PREFIX=Jigsa Bulto
# Public portal origin used in account setup and report-ready emails.
PORTAL_PUBLIC_URL=https://portal.example.com

MAIL_ENABLED=false
MAIL_SENDER=notifications@yourdomain.com
# Optional: set these only if email should use a different Entra app than SharePoint/Power BI.
MAIL_TENANT_ID=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=

POWERBI_WORKSPACE_ID=your-powerbi-workspace-id
POWERBI_REPORT_ID=your-powerbi-report-id
POWERBI_DATASET_ID=your-powerbi-dataset-id
POWERBI_DEFAULT_EFFECTIVE_USERNAME=
POWERBI_DEFAULT_EFFECTIVE_ROLES=AllProjects
INDIVIDUAL_REPORT_NAME=IR_PO_Baseline_v3_test
POWERBI_REFRESH_TIMEOUT_SECONDS=900
POWERBI_REFRESH_POLL_SECONDS=5
# Fabric capacity resource ID, used when no capacity is already saved in the database.
# Automatic refresh remains disabled until dashboards are selected and saved.
FABRIC_CAPACITY_RESOURCE_ID=

# Comma-separated SurveyCTO form IDs exposed by the raw survey relay.
SURVEY_RELAY_ALLOWED_FORMS=bayer_safe_handling_baseline_assessment,blfa_farmer_baseline_questionnaire
